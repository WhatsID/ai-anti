{
  "review": {
    "channels": [
      "codex",
      "same-family"
    ],
    "codex_model": "gpt-6-astra"
  },
  "defaults": {
    "deployment_scale": null
  },
  "claude_review": {
    "model_families": {
      "opus": "claude-opus-[0-9]+(?:-[0-9]+)*",
      "fable": "claude-fable-[0-9]+(?:-[0-9]+)*"
    }
  },
  "codex_relay": {
    "review_channel": "claude",
    "secondary_model": null,
    "qwen_executor": "claude"
  },
  "plugins": {
    "qwen": {
      "model": "qwen3.8-max",
      "base_url": "https://token-plan.maas.qianwenaiapi.com/apps/anthropic",
      "responses_base_url": "https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1",
      "credential_paths": [],
      "credential_key": "review_services.token_plan.value"
    }
  },
  "relay": {
    "default_mode": "rules"
  },
  "desktop": {
    "primary_host": "claude"
  },
  "review_services": {
    "version": 1,
    "active_api": "token_plan",
    "profiles": {
      "token_plan": {
        "model": "qwen3.8-max",
        "base_url": "https://token-plan.maas.qianwenaiapi.com/apps/anthropic",
        "responses_base_url": "https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1",
        "credential_paths": [],
        "credential_key": "review_services.token_plan.value"
      },
      "custom_api": {
        "model": "",
        "base_url": "",
        "responses_base_url": "",
        "credential_paths": [],
        "credential_key": "review_services.custom_api.value"
      }
    }
  }
}
