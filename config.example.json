{
  "review": {
    "channels": [
      "codex",
      "same-family"
    ],
    "codex_model": "gpt-6-astra",
    "codex_effort": "high",
    "codex_high_risk_effort": "xhigh",
    "timeout": 1800,
    "idle_timeout": 900
  },
  "defaults": {
    "deployment_scale": null
  },
  "claude_review": {
    "model_families": {
      "opus": "claude-opus-[0-9]+(?:-[0-9]+)*",
      "fable": "claude-fable-[0-9]+(?:-[0-9]+)*"
    }
  },
  "claude_relay": {
    "qwen_executor": "claude",
    "implementation": {"provider": "codex", "model": "gpt-6.2-sol",
                       "effort": "high"},
    "dual_plan": {
      "enabled": false,
      "partner": "agy",
      "model": null,
      "effort": null,
      "synthesizer": "claude",
      "on_failure": "stop"
    }
  },
  "codex_relay": {
    "review_channel": "claude",
    "secondary_model": null,
    "qwen_executor": "claude",
    "implementation_provider": "codex",
    "token_plan_implementation_model": "glm-5.3"
  },
  "agy_relay": {
    "review": {
      "provider": "codex",
      "model": "gpt-6.2-astra",
      "effort": "high",
      "high_risk_effort": "xhigh"
    },
    "implementation": {
      "provider": "codex",
      "model": "gpt-6.2-sol",
      "effort": "high"
    },
    "dual_plan": {
      "enabled": false,
      "partner": "claude",
      "model": null,
      "effort": null,
      "synthesizer": "agy",
      "on_failure": "stop"
    }
  },
  "plugins": {
    "qwen": {
      "model": "qwen3.8-max",
      "base_url": "https://token-plan.maas.qianwenaiapi.com/apps/anthropic",
      "responses_base_url": "https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1",
      "credential_paths": [],
      "credential_key": "model_services.token_plan.value"
    }
  },
  "relay": {
    "default_mode": "rules"
  },
  "desktop": {
    "primary_host": "claude"
  },
  "model_services": {
    "version": 1,
    "active_api": "token_plan",
    "profiles": {
      "token_plan": {
        "model": "qwen3.8-max",
        "base_url": "https://token-plan.maas.qianwenaiapi.com/apps/anthropic",
        "responses_base_url": "https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1",
        "credential_paths": [],
        "credential_key": "model_services.token_plan.value"
      },
      "custom_api": {
        "model": "",
        "base_url": "",
        "responses_base_url": "",
        "credential_paths": [],
        "credential_key": "model_services.custom_api.value"
      }
    }
  },
  "token_plan_accounts": {
    "version": 1,
    "auto_failover": false,
    "backup": {
      "credential_paths": [],
      "credential_key": "model_services.token_plan_backup.value"
    }
  }
}
